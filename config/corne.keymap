#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ALPHA 0
#define NUM   1
#define SYM   2
#define NAV   3
#define MEDIA 4

/ {
  behaviors {
    hrm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <150>;
      quick-tap-ms = <0>;
      bindings = <&kp>, <&kp>;
    };
    ltb: layer_tap_balanced {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <150>;
      quick-tap-ms = <120>;
      bindings = <&mo>, <&kp>;
    };
  };

  combos {
    compatible = "zmk,combos";
    caps {
      bindings = <&caps_word>;
      key-positions = <24 35>;
    };
    raycast {
      timeout-ms = <80>;
      bindings = <&kp LG(SPACE)>;
      key-positions = <38 39>;
    };
  };

  macros {
    tm1: tm1 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_tap &kp GRAVE &kp N1>;
    };
    tm2: tm2 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_tap &kp GRAVE &kp N2>;
    };
    tm3: tm3 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_tap &kp GRAVE &kp N3>;
    };
    tm4: tm4 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_tap &kp GRAVE &kp N4>;
    };
    tmnext: tmnext {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_tap &kp GRAVE &kp N>;
    };
    tmprev: tmprev {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_tap &kp GRAVE &kp P>;
    };
    app1: app1 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_press &kp LALT>, <&macro_tap &kp N1>, <&macro_release &kp LALT>;
    };
    app2: app2 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_press &kp LALT>, <&macro_tap &kp N2>, <&macro_release &kp LALT>;
    };
    app3: app3 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_press &kp LALT>, <&macro_tap &kp N3>, <&macro_release &kp LALT>;
    };
    app4: app4 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&macro_press &kp LALT>, <&macro_tap &kp N4>, <&macro_release &kp LALT>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    alpha {
      bindings = <
        &kp TAB    &kp Q         &kp W              &kp E        &kp R         &kp T  &kp Y           &kp U         &kp I        &kp O         &kp P          &kp BSPC
        &kp ESC    &hrm LCTRL A  &hrm LALT S        &hrm LGUI D  &hrm LSHFT F  &kp G  &kp H           &hrm LSHFT J  &hrm LGUI K  &hrm LALT L  &hrm LCTRL SQT  &kp ENTER
        &kp GRAVE  &kp Z         &kp X              &kp C        &kp V         &kp B  &kp N           &kp M         &kp COMMA    &kp DOT       &kp FSLH       &kp GLOBE
        &mo MEDIA  &mo NAV       &ltb NUM LA(BSPC)                                   &ltb SYM SPACE  &mo NAV        &mo MEDIA
      >;
      label = "alpha";
    };

    num {
      bindings = <
        &trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5   &kp FSLH  &kp N7   &kp N8   &kp N9   &kp MINUS  &trans
        &trans  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10  &kp STAR  &kp N4   &kp N5   &kp N6   &kp PLUS   &trans
        &trans  &kp F11  &kp F12  &none   &none   &none    &kp N0    &kp N1   &kp N2   &kp N3   &kp DOT    &trans
        &trans  &trans   &trans                            &trans    &trans   &trans
      >;
      label = "num";
    };

    sym {
      bindings = <
        &trans  &kp QMARK  &kp AT    &kp HASH  &kp DLLR   &kp PRCT   &kp PIPE   &kp STAR   &kp AMPS  &kp CARET  &kp EXCL   &trans
        &trans  &kp MINUS  &kp FSLH  &kp LBRC  &kp LPAR   &kp LBKT   &kp RBKT   &kp RPAR   &kp RBRC  &kp BSLH   &kp PLUS   &trans
        &trans  &kp SEMI   &kp SQT   &kp LT    &kp EQUAL  &kp GRAVE  &kp TILDE  &kp UNDER  &kp GT    &kp DQT    &kp COLON  &trans
        &trans  &trans     &trans                                    &trans     &trans     &trans
      >;
      label = "sym";
    };

    nav {
      bindings = <
        &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR  &none     &app1                 &app2                  &app3                  &app4  &trans
        &trans  &tm1          &tm2          &tm3          &tm4          &none       &kp LEFT  &kp DOWN              &kp UP                 &kp RIGHT              &none  &trans
        &trans  &none         &none         &tmprev       &tmnext       &none       &none     &kp LG(LA(LC(LEFT)))  &kp LG(LA(LC(ENTER)))  &kp LG(LA(LC(RIGHT)))  &none  &trans
        &trans  &trans        &trans                                                &trans    &trans                &trans
      >;
      label = "nav";
    };

    media {
      bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans                          &trans  &trans  &trans
      >;
      label = "media";
    };
  };
};
