{
  "title": "Colemak-DH (no shortcut passthrough)",
  "rules": [
    {
      "description": "Colemak-DH — full remap including Cmd shortcuts (relearn shortcuts in Colemak positions)",
      "manipulators": [
        { "type": "basic", "from": { "key_code": "e" }, "to": [{ "key_code": "f" }] },
        { "type": "basic", "from": { "key_code": "r" }, "to": [{ "key_code": "p" }] },
        { "type": "basic", "from": { "key_code": "t" }, "to": [{ "key_code": "b" }] },
        { "type": "basic", "from": { "key_code": "y" }, "to": [{ "key_code": "j" }] },
        { "type": "basic", "from": { "key_code": "u" }, "to": [{ "key_code": "l" }] },
        { "type": "basic", "from": { "key_code": "i" }, "to": [{ "key_code": "u" }] },
        { "type": "basic", "from": { "key_code": "o" }, "to": [{ "key_code": "y" }] },
        { "type": "basic", "from": { "key_code": "p" }, "to": [{ "key_code": "semicolon" }] },

        { "type": "basic", "from": { "key_code": "s" }, "to": [{ "key_code": "r" }] },
        { "type": "basic", "from": { "key_code": "d" }, "to": [{ "key_code": "s" }] },
        { "type": "basic", "from": { "key_code": "f" }, "to": [{ "key_code": "t" }] },
        { "type": "basic", "from": { "key_code": "h" }, "to": [{ "key_code": "m" }] },
        { "type": "basic", "from": { "key_code": "j" }, "to": [{ "key_code": "n" }] },
        { "type": "basic", "from": { "key_code": "k" }, "to": [{ "key_code": "e" }] },
        { "type": "basic", "from": { "key_code": "l" }, "to": [{ "key_code": "i" }] },
        { "type": "basic", "from": { "key_code": "semicolon" }, "to": [{ "key_code": "o" }] },

        { "type": "basic", "from": { "key_code": "v" }, "to": [{ "key_code": "d" }] },
        { "type": "basic", "from": { "key_code": "b" }, "to": [{ "key_code": "v" }] },
        { "type": "basic", "from": { "key_code": "n" }, "to": [{ "key_code": "k" }] },
        { "type": "basic", "from": { "key_code": "m" }, "to": [{ "key_code": "h" }] }
      ]
    }
  ]
}
